---
// LS212Diagram — sơ đồ nguyên lý động: LS212 đấu sai cực dây tín hiệu thì
// đèn RUN nháy nhanh mãi không dừng; đảo lại 2 đầu dây thì RUN sáng cố định.
// Nội dung theo B1.02 mục 7.3, B1.03 mục 6.1, B1.01 bảng đèn LS212.
// Chuẩn hiệu ứng v3: hiệu ứng bám đúng phần tử thật (đèn LED trên thân máy,
// dây tín hiệu, chân terminal), không hiệu ứng trang trí bay lượn.
// Tự chạy khi cuộn tới vị trí (IntersectionObserver), tôn trọng
// prefers-reduced-motion. Root gắn not-content + reset margin theo quy tắc
// chung của các component MDX trên wiki.

interface Props {
  title?: string;
}

const { title = 'Sơ đồ động — LS212: đấu sai cực dây tín hiệu' } = Astro.props as Props;
const uid = 'lsd-' + Math.random().toString(36).slice(2, 9);
const pwrId = uid + '-pwr';
const sigOutId = uid + '-sigout';
const sigBackId = uid + '-sigback';
const arrId = uid + '-arr';
---

<div class="ls212-diagram not-content" id={uid}>
  <p class="ad-heading">{title}</p>
  <p class="ad-sub">LS212 nối 1–1 vào dàn lạnh qua 2 dây tín hiệu ở cổng AIR CON. Với hãng có phân cực: đấu chéo 2 dây thì đèn RUN nháy nhanh mãi không dừng — ngắt điện, đảo lại 2 đầu dây là RUN sáng cố định.</p>

  <svg viewBox="0 0 940 560" role="img" aria-label="Sơ đồ động LS212 đấu sai cực dây tín hiệu, đèn RUN nháy nhanh, đảo lại dây thì kết nối thành công">
    <text x="70" y="34" class="lbl-b">Nguồn 12V DC</text>
    <text x="70" y="52" class="lbl-sm">(hoặc nguồn từ board dàn lạnh)</text>
    <path data-role="pwrwire" id={pwrId} d="M200,44 L200,118" fill="none" stroke="#9CA3AF" stroke-width="2.4" />
    <circle data-role="pwrdot" r="5" fill="var(--amber)" opacity="0">
      <animateMotion dur="0.9s" repeatCount="indefinite"><mpath href={`#${pwrId}`} /></animateMotion>
    </circle>

    <rect data-role="boxLS" class="box" x="70" y="118" width="262" height="232" rx="10" />
    <text x="201" y="146" text-anchor="middle" class="lbl-b">LS212 PRO</text>
    <text x="201" y="164" text-anchor="middle" class="lbl-sm">1 bộ cho 1 dàn lạnh</text>
    <circle data-role="runLed" class="led" cx="118" cy="192" r="10" />
    <text x="134" y="197" class="lbl-b">RUN</text>
    <circle data-role="staLed" class="led" cx="212" cy="192" r="10" />
    <text x="228" y="197" class="lbl-b">STA</text>
    <text x="118" y="222" class="lbl-sm">tìm thấy = sáng cố định</text>
    <rect x="102" y="238" width="52" height="22" rx="5" fill="#fff" stroke="var(--navy)" stroke-width="1.4" />
    <text x="128" y="253" text-anchor="middle" class="lbl-sm" style="fill:var(--navy);font-weight:700">SET</text>
    <text x="164" y="253" class="lbl-sm">nút cài đặt</text>
    <rect x="187" y="106" width="28" height="18" rx="3" fill="#374151" /><text x="201" y="119" text-anchor="middle" class="term">12V</text>
    <text x="86" y="302" class="lbl-b">Cổng AIR CON</text>
    <text x="86" y="320" class="lbl-sm">2 chân tín hiệu có phân cực</text>
    <rect data-term="lt1" x="318" y="212" width="28" height="20" rx="3" fill="var(--wire-red)" /><text x="332" y="226" text-anchor="middle" class="term">1</text>
    <rect data-term="lt2" x="318" y="262" width="28" height="20" rx="3" fill="var(--wire-blue)" /><text x="332" y="276" text-anchor="middle" class="term">2</text>

    <path data-role="w1" class="sigwire" stroke="var(--wire-red)" d="M346,222 L594,272" />
    <path data-role="w2" class="sigwire" stroke="var(--wire-blue)" d="M346,272 L594,222" />
    <path data-role="sigOut" id={sigOutId} d="M346,222 L594,272" fill="none" stroke="none" />
    <path data-role="sigBack" id={sigBackId} d="M346,272 L594,222" fill="none" stroke="none" />
    <circle data-role="pktOut" r="6" fill="var(--amber)" opacity="0">
      <animateMotion data-role="animOut" dur="1.0s" begin="indefinite" fill="freeze"><mpath href={`#${sigOutId}`} /></animateMotion>
    </circle>
    <circle data-role="pktBack" r="6" fill="var(--ok)" opacity="0">
      <animateMotion data-role="animBack" dur="1.0s" begin="indefinite" fill="freeze"><mpath href={`#${sigBackId}`} /></animateMotion>
    </circle>
    <g data-role="swapArrows" class="fadeable">
      <path d="M448,196 A58,30 0 0 1 492,196" fill="none" stroke="var(--navy)" stroke-width="2.2" marker-end={`url(#${arrId})`} />
      <path d="M492,298 A58,30 0 0 1 448,298" fill="none" stroke="var(--navy)" stroke-width="2.2" marker-end={`url(#${arrId})`} />
      <defs><marker id={arrId} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="var(--navy)" /></marker></defs>
    </g>
    <g data-role="errX" class="fadeable">
      <circle cx="470" cy="247" r="17" fill="#fff" stroke="var(--red)" stroke-width="2.4" />
      <path d="M460,237 L480,257 M480,237 L460,257" stroke="var(--red)" stroke-width="3" stroke-linecap="round" />
    </g>

    <rect data-role="boxAC" class="box" x="608" y="118" width="262" height="232" rx="10" />
    <text x="739" y="146" text-anchor="middle" class="lbl-b">Dàn lạnh</text>
    <text x="739" y="164" text-anchor="middle" class="lbl-sm">board tín hiệu</text>
    <circle data-role="acLed" class="led" cx="700" cy="192" r="10" />
    <text x="716" y="197" class="lbl-b">Board</text>
    <text x="700" y="222" class="lbl-sm">nhận tín hiệu</text>
    <rect x="664" y="252" width="150" height="42" rx="7" fill="#fff" stroke="var(--navy)" stroke-width="1.5" />
    <line x1="676" y1="266" x2="802" y2="266" stroke="#94A3B8" stroke-width="2.2" />
    <line x1="676" y1="278" x2="802" y2="278" stroke="#94A3B8" stroke-width="2.2" />
    <path class="cool" d="M690,306 L684,326" />
    <path class="cool" d="M739,306 L739,328" />
    <path class="cool" d="M788,306 L794,326" />
    <text x="739" y="342" text-anchor="middle" class="lbl-sm">dàn lạnh chạy khi đã kết nối</text>
    <rect data-term="bt1" x="594" y="212" width="28" height="20" rx="3" fill="var(--wire-red)" /><text x="608" y="226" text-anchor="middle" class="term">1</text>
    <rect data-term="bt2" x="594" y="262" width="28" height="20" rx="3" fill="var(--wire-blue)" /><text x="608" y="276" text-anchor="middle" class="term">2</text>

    <rect x="70" y="392" width="800" height="92" rx="10" fill="#F8FAFC" stroke="var(--line)" />
    <text x="92" y="420" class="lbl-b">Đọc đèn RUN ngay trên thân LS212:</text>
    <circle cx="100" cy="442" r="6" fill="var(--ok)" />
    <text x="114" y="447" class="lbl">Sáng cố định — tìm thấy dàn lạnh, chạy bình thường</text>
    <circle cx="100" cy="466" r="6" fill="var(--amber)" />
    <text x="114" y="471" class="lbl">Nháy nhanh — đang tìm · nháy mãi không dừng = sai cực dây hoặc sai hãng đã chọn</text>

    <g class="callout" data-co="1"><rect x="356" y="150" width="228" height="26" rx="13" /><text x="470" y="167" text-anchor="middle">Đấu chéo: 1 → 2 · 2 → 1</text></g>
    <g class="callout" data-co="2"><rect x="52" y="66" width="296" height="26" rx="13" /><text x="200" y="83" text-anchor="middle">Cấp điện — RUN nháy nhanh: đang tìm</text></g>
    <g class="callout red" data-co="3"><rect x="316" y="330" width="308" height="26" rx="13" /><text x="470" y="347" text-anchor="middle">Vẫn nháy nhanh mãi — không tìm thấy dàn lạnh</text></g>
    <g class="callout" data-co="4"><rect x="330" y="150" width="280" height="26" rx="13" /><text x="470" y="167" text-anchor="middle">Ngắt điện — đảo lại 2 đầu dây</text></g>
    <g class="callout" data-co="5"><rect x="596" y="66" width="300" height="26" rx="13" /><text x="746" y="83" text-anchor="middle">RUN sáng cố định — đã kết nối</text></g>
  </svg>

  <div class="phasebar"><div class="phasefill" data-role="fill"></div></div>
  <div class="bar2">
    <span class="phname" data-role="phname"></span>
    <div class="dots" data-role="dots"></div>
    <button type="button" class="playbtn primary" data-role="playbtn">Tạm dừng</button>
    <span class="cnt" data-role="cnt"></span>
  </div>
</div>

<style is:global>
  .ls212-diagram {
    --navy:#0F172A; --red:#AB1313; --wire-red:#DC2626; --wire-blue:#2563EB; --ink:#1F2937; --mut:#6B7280; --line:#CBD5E1; --ok:#16A34A; --amber:#D97706;
    background:#fff; border:1px solid var(--line); border-radius:12px; padding:18px; margin:1.2em 0;
  }
  .ls212-diagram, .ls212-diagram * { margin-top:0; margin-bottom:0; }
  .ls212-diagram .ad-heading { font-size:1.05rem; font-weight:700; color:var(--navy); margin:0 0 4px; }
  .ls212-diagram .ad-sub { color:var(--mut); font-size:.86rem; margin:0 0 14px; line-height:1.45; }
  .ls212-diagram svg { width:100%; height:auto; display:block; }
  .ls212-diagram .lbl { font-size:13px; fill:var(--ink); }
  .ls212-diagram .lbl-sm { font-size:11px; fill:var(--mut); }
  .ls212-diagram .lbl-b { font-size:13px; font-weight:700; fill:var(--navy); }
  .ls212-diagram .term { font-size:11px; font-weight:700; fill:#fff; }
  .ls212-diagram .box { fill:#F8FAFC; stroke:var(--navy); stroke-width:1.6; transition:filter .3s, stroke .3s; }
  .ls212-diagram .box.pulse { filter:drop-shadow(0 0 10px rgba(22,163,74,.55)); }
  .ls212-diagram .box.err { stroke:var(--red); }
  .ls212-diagram .flow { stroke-dasharray:7 6; animation:lsd-dash 1.1s linear infinite; }
  @keyframes lsd-dash { to { stroke-dashoffset:-13; } }
  .ls212-diagram .sigwire { fill:none; stroke-width:3; transition:stroke-width .25s; }
  .ls212-diagram .sigwire.hot { stroke-width:4.2; }
  .ls212-diagram .led { fill:#E5E7EB; stroke:#9CA3AF; stroke-width:1.4; transition:fill .2s; }
  .ls212-diagram .led.on { fill:var(--ok); stroke:var(--ok); filter:drop-shadow(0 0 7px rgba(22,163,74,.9)); }
  .ls212-diagram .led.blinkfast { fill:var(--ok); stroke:var(--ok); animation:lsd-blinkf .36s steps(2,start) infinite; }
  @keyframes lsd-blinkf { 50% { fill:#E5E7EB; filter:none; } }
  .ls212-diagram .termflash { animation:lsd-tf .5s ease-in-out 3; }
  @keyframes lsd-tf { 50% { filter:brightness(1.8); } }
  .ls212-diagram .callout { opacity:0; transition:opacity .3s; }
  .ls212-diagram .callout.on { opacity:1; }
  .ls212-diagram .callout rect { fill:var(--navy); }
  .ls212-diagram .callout text { fill:#fff; font-size:12.5px; font-weight:600; }
  .ls212-diagram .callout.red rect { fill:var(--red); }
  .ls212-diagram .fadeable { opacity:0; transition:opacity .35s; }
  .ls212-diagram .fadeable.on { opacity:1; }
  .ls212-diagram .cool { stroke:#38BDF8; stroke-width:2.4; stroke-linecap:round; opacity:0; transition:opacity .35s; }
  .ls212-diagram .cool.on { opacity:1; }
  .ls212-diagram .phasebar { height:5px; background:#E5E7EB; border-radius:3px; overflow:hidden; margin-top:12px; }
  .ls212-diagram .phasefill { height:100%; width:0; background:var(--red); }
  .ls212-diagram .bar2 { display:flex; align-items:center; gap:10px; margin-top:12px; flex-wrap:wrap; }
  .ls212-diagram .playbtn { font:inherit; font-size:14px; padding:8px 16px; border-radius:8px; border:1px solid var(--navy); background:#fff; color:var(--navy); cursor:pointer; }
  .ls212-diagram .playbtn.primary { background:var(--navy); color:#fff; }
  .ls212-diagram .dots { display:flex; gap:6px; }
  .ls212-diagram .dot { width:9px; height:9px; border-radius:50%; background:#CBD5E1; border:none; padding:0; cursor:pointer; }
  .ls212-diagram .dot.act { background:var(--red); }
  .ls212-diagram .phname { font-size:14.5px; font-weight:600; color:var(--navy); }
  .ls212-diagram .cnt { color:var(--mut); font-size:13px; margin-left:auto; }
</style>

<script>
  document.querySelectorAll('.ls212-diagram').forEach((root) => {
    if (root.dataset.init) return;
    root.dataset.init = '1';
    const q = (sel) => root.querySelector(sel);
    const qa = (sel) => root.querySelectorAll(sel);
    const CROSS1 = 'M346,222 L594,272', CROSS2 = 'M346,272 L594,222';
    const STR1 = 'M346,222 L594,222', STR2 = 'M346,272 L594,272';
    let solidTimer = null;
    function setWires(cross) {
      q('[data-role="w1"]').setAttribute('d', cross ? CROSS1 : STR1);
      q('[data-role="w2"]').setAttribute('d', cross ? CROSS2 : STR2);
      q('[data-role="sigOut"]').setAttribute('d', cross ? CROSS1 : STR1);
      q('[data-role="sigBack"]').setAttribute('d', cross ? CROSS2 : STR2);
    }
    function flash(el) { if (!el) return; el.classList.remove('termflash'); void el.getBBox(); el.classList.add('termflash'); }
    function term(name) { return root.querySelector('[data-term="' + name + '"]'); }
    function co(n) { return root.querySelector('[data-co="' + n + '"]'); }
    function runOff() { const el = q('[data-role="runLed"]'); el.classList.remove('on', 'blinkfast'); }
    function runBlink() { const el = q('[data-role="runLed"]'); el.classList.remove('on'); el.classList.add('blinkfast'); }
    function runSolid() { const el = q('[data-role="runLed"]'); el.classList.remove('blinkfast'); el.classList.add('on'); }
    function power(on) {
      q('[data-role="pwrwire"]').setAttribute('stroke', on ? 'var(--wire-red)' : '#9CA3AF');
      q('[data-role="pwrdot"]').setAttribute('opacity', on ? '1' : '0');
    }
    function resetAll() {
      if (solidTimer) { clearTimeout(solidTimer); solidTimer = null; }
      power(false); runOff();
      q('[data-role="staLed"]').classList.remove('on', 'blinkfast');
      q('[data-role="acLed"]').classList.remove('on', 'blinkfast');
      q('[data-role="boxLS"]').classList.remove('pulse', 'err');
      q('[data-role="boxAC"]').classList.remove('pulse', 'err');
      q('[data-role="w1"]').classList.remove('hot', 'flow');
      q('[data-role="w2"]').classList.remove('hot', 'flow');
      q('[data-role="pktOut"]').setAttribute('opacity', '0');
      q('[data-role="pktBack"]').setAttribute('opacity', '0');
      q('[data-role="errX"]').classList.remove('on');
      q('[data-role="swapArrows"]').classList.remove('on');
      qa('.cool').forEach((el) => el.classList.remove('on'));
      qa('.callout').forEach((el) => el.classList.remove('on'));
      setWires(true);
    }
    const phases = [
      { name: 'Trạng thái chờ — LS212 chưa cấp điện, RUN tắt', dur: 2000, run() {} },
      { name: 'Đấu sai cực — 2 dây tín hiệu chéo nhau ở phía board', dur: 2600, run() {
          q('[data-role="w1"]').classList.add('hot'); q('[data-role="w2"]').classList.add('hot');
          flash(term('bt1')); flash(term('bt2')); flash(term('lt1')); flash(term('lt2'));
          co(1).classList.add('on');
        } },
      { name: 'Cấp điện — RUN nháy nhanh: đang tìm dàn lạnh (bình thường lúc đầu)', dur: 2800, run() {
          power(true); runBlink();
          q('[data-role="w1"]').classList.add('flow'); q('[data-role="w2"]').classList.add('flow');
          q('[data-role="pktOut"]').setAttribute('opacity', '1'); q('[data-role="animOut"]').beginElement();
          co(2).classList.add('on');
        } },
      { name: 'RUN nháy nhanh mãi không dừng — tín hiệu không qua được, chưa tìm thấy dàn lạnh', dur: 3200, run() {
          power(true); runBlink();
          q('[data-role="w1"]').classList.add('flow'); q('[data-role="w2"]').classList.add('flow');
          q('[data-role="boxAC"]').classList.add('err'); q('[data-role="boxLS"]').classList.add('err');
          q('[data-role="errX"]').classList.add('on'); co(3).classList.add('on');
        } },
      { name: 'Ngắt điện — đảo lại 2 đầu dây tín hiệu cho thẳng cực', dur: 3000, run() {
          setWires(false);
          q('[data-role="w1"]').classList.add('hot'); q('[data-role="w2"]').classList.add('hot');
          flash(term('bt1')); flash(term('bt2'));
          q('[data-role="swapArrows"]').classList.add('on'); co(4).classList.add('on');
        } },
      { name: 'Cấp điện lại — RUN nháy nhanh vài nhịp rồi sáng cố định, dàn lạnh đáp ứng', dur: 3600, run() {
          setWires(false); power(true); runBlink();
          q('[data-role="w1"]').classList.add('flow'); q('[data-role="w2"]').classList.add('flow');
          q('[data-role="pktOut"]').setAttribute('opacity', '1'); q('[data-role="animOut"]').beginElement();
          solidTimer = setTimeout(() => {
            runSolid();
            q('[data-role="staLed"]').classList.add('on');
            q('[data-role="acLed"]').classList.add('on');
            q('[data-role="boxLS"]').classList.add('pulse'); q('[data-role="boxAC"]').classList.add('pulse');
            qa('.cool').forEach((el) => el.classList.add('on'));
            q('[data-role="pktBack"]').setAttribute('opacity', '1'); q('[data-role="animBack"]').beginElement();
            co(5).classList.add('on');
          }, 1200);
        } },
    ];
    let idx = 0, playing = false, raf = null, phaseStart = 0;
    const dotsEl = q('[data-role="dots"]');
    phases.forEach((p, i) => {
      const d = document.createElement('button');
      d.type = 'button'; d.className = 'dot'; d.setAttribute('aria-label', 'Giai đoạn ' + (i + 1));
      d.onclick = () => jump(i);
      dotsEl.appendChild(d);
    });
    function apply(i) {
      resetAll(); idx = i; phases[i].run();
      q('[data-role="phname"]').textContent = phases[i].name;
      q('[data-role="cnt"]').textContent = (i + 1) + ' / ' + phases.length;
      [...dotsEl.children].forEach((d, k) => d.classList.toggle('act', k === i));
      phaseStart = performance.now();
    }
    function tick(now) {
      if (!playing) return;
      const el = now - phaseStart, d = phases[idx].dur;
      q('[data-role="fill"]').style.width = Math.min(100, el / d * 100) + '%';
      if (el >= d) apply((idx + 1) % phases.length);
      raf = requestAnimationFrame(tick);
    }
    function play() {
      if (playing) return; playing = true;
      q('[data-role="playbtn"]').textContent = 'Tạm dừng';
      phaseStart = performance.now() - (parseFloat(q('[data-role="fill"]').style.width) || 0) / 100 * phases[idx].dur;
      raf = requestAnimationFrame(tick);
    }
    function pause() {
      playing = false; q('[data-role="playbtn"]').textContent = 'Tự chạy';
      if (raf) cancelAnimationFrame(raf);
    }
    function jump(i) { apply(i); if (playing) phaseStart = performance.now(); q('[data-role="fill"]').style.width = '0%'; }
    q('[data-role="playbtn"]').onclick = () => (playing ? pause() : play());
    apply(0);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => { es.forEach((e) => { e.isIntersecting ? play() : pause(); }); }, { threshold: 0.35 });
      io.observe(root);
    }
  });
</script>
